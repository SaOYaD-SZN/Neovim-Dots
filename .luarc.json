{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT"
  },
  "workspace": {
    "library": [
      "${3rd}/luv/library",
      "${3rd}/busted/library"
    ],
    "checkThirdParty": false
  },
  "diagnostics": {
    "globals": [
      "vim",
      "Snacks"
    ],
    "unusedLocalExclude": ["_*"]
  },
  "completion": {
    "callSnippet": "Replace"
  },
  "hint": {
    "enable": true,
    "setType": true,
    "paramType": true,
    "paramName": "Disable",
    "semicolon": "Disable",
    "arrayIndex": "Disable"
  },
  "format": {
    "enable": false
  }
}
